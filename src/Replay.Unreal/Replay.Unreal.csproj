        <IsPackable>true</IsPackable>
        <PackageId>ValorantReplayParser.Unreal</PackageId>
        <Description>VALORANT replay container, header, chunk, and network parsing.</Description>
    </PropertyGroup>

    <Import Project="$(MSBuildThisFileDirectory)..\..\build\LibraryPackage.props" />

    <ItemGroup>
      <ProjectReference Include="..\Replay.Encoding\Replay.Encoding.csproj" />
      <ProjectReference Include="..\Replay.Models\Replay.Models.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    </ItemGroup>

</Project>
