<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Replay.Valorant</RootNamespace>
        <IsPackable>true</IsPackable>
        <PackageId>ValorantReplayParser</PackageId>
        <Description>VALORANT replay (.vrf) parsing with typed gameplay events and replay metadata. Experimental API.</Description>
    </PropertyGroup>

    <Import Project="$(MSBuildThisFileDirectory)..\..\build\LibraryPackage.props" />

    <ItemGroup>
        <ProjectReference Include="..\Replay.Models\Replay.Models.csproj" />
        <ProjectReference Include="..\Replay.Unreal\Replay.Unreal.csproj" />
    </ItemGroup>

    <ItemGroup>
      <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
        <_Parameter1>Replay.Valorant.Tests</_Parameter1>
      </AssemblyAttribute>
    </ItemGroup>

</Project>
